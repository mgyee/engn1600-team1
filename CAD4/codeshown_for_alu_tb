** add two numbers xor two numbers waveform
name=s1 only_toplevel=false value="

.control

** Define input signals
let f = 1e8
let T = 1/f
let PW = T/2

let QT = T/4
let TQT = QT * 3

let tstop = 4 * T
let tstep = 0.001 * T

** A0 and B0 square waves
alter @VA0[PULSE] = [ 0 3.3 0 0 0 $&PW $&T 0 ]
alter @VB0[PULSE] = [ 0 3.3 $&QT 0 0 $&PW $&T 0 ]

** A1 and B1 square waves (different phase)
alter @VA1[PULSE] = [ 0 3.3 $&PW 0 0 $&PW $&T 0 ]
alter @VB1[PULSE] = [ 0 3.3 $&TQT 0 0 $&PW $&T 0 ]

tran $&tstep $&tstop

** Monitor signals
plot Y0 Y1+4 A0+8 B0+12 A1+16 B1+20

write alu_tb.raw

.endc
"


